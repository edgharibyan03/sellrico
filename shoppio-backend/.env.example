# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1

# Database
DATABASE_URL=postgresql://shoppio:shoppio@localhost:5432/shoppio?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Comma-separated browser origins for sellrico-web
CORS_ORIGINS=http://localhost:3001,http://localhost:3003

# OpenAI (pro / business plans)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# DeepSeek (free plan) — OpenAI-compatible API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Legacy alias for OPENAI_API_KEY (optional)
# AI_PROVIDER_API_KEY=
