generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISCONNECTED
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model User {
  id                   String   @id @default(uuid()) @db.Uuid
  email                String   @unique
  name                 String
  passwordHash         String   @map("password_hash")
  onboardingCompleted  Boolean  @default(false) @map("onboarding_completed")
  onboardingStep       Int      @default(0) @map("onboarding_step")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  sites Site[]

  @@map("users")
}

model Site {
  id           String     @id @default(uuid()) @db.Uuid
  ownerUserId  String?    @map("owner_user_id") @db.Uuid
  domain       String
  name         String
  status       SiteStatus @default(PENDING)
  lastSyncedAt DateTime?  @map("last_synced_at")
  planId       String     @default("free") @map("plan_id") @db.VarChar(32)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  owner         User?             @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  credentials   SiteCredential[]
  connectCodes  SiteConnectCode[]
  products      Product[]
  conversations Conversation[]
  usageEvents   UsageEvent[]

  @@index([domain])
  @@index([ownerUserId])
  @@map("sites")
}

model SiteConnectCode {
  id        String    @id @default(uuid()) @db.Uuid
  siteId    String    @map("site_id") @db.Uuid
  code      String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_connect_codes")
}

model SiteCredential {
  id         String           @id @default(uuid()) @db.Uuid
  siteId     String           @map("site_id") @db.Uuid
  keyId      String           @unique @map("key_id")
  secretHash String           @map("secret_hash")
  label      String           @default("default")
  status     CredentialStatus @default(ACTIVE)
  lastUsedAt DateTime?        @map("last_used_at")
  revokedAt  DateTime?        @map("revoked_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_credentials")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  siteId            String   @map("site_id") @db.Uuid
  externalProductId String   @map("external_product_id")
  name              String
  description       String?  @db.Text
  price             Decimal? @db.Decimal(12, 2)
  currency          String?  @db.VarChar(3)
  url               String?
  imageUrl          String?  @map("image_url")
  stockStatus       String?  @map("stock_status") @db.VarChar(32)
  category          String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, externalProductId])
  @@index([siteId])
  @@index([siteId, name])
  @@map("products")
}

model Conversation {
  id                String             @id @default(uuid()) @db.Uuid
  siteId            String             @map("site_id") @db.Uuid
  externalSessionId String?            @map("external_session_id")
  status            ConversationStatus @default(OPEN)
  metadata          Json?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([siteId])
  @@index([siteId, externalSessionId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String      @db.Text
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model UsageEvent {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  type      String
  quantity  Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([siteId, type, createdAt])
  @@map("usage_events")
}
