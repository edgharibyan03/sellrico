generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SiteStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISCONNECTED
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

model User {
  id                   String   @id @default(uuid()) @db.Uuid
  email                String   @unique
  name                 String
  passwordHash         String   @map("password_hash")
  onboardingCompleted  Boolean  @default(false) @map("onboarding_completed")
  onboardingStep       Int      @default(0) @map("onboarding_step")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  sites         Site[]
  subscription  Subscription?
  usagePeriods  UsagePeriod[]
  aiUsageRecords AiUsageRecord[]

  @@map("users")
}

model Site {
  id           String     @id @default(uuid()) @db.Uuid
  ownerUserId  String?    @map("owner_user_id") @db.Uuid
  domain       String
  name         String
  status       SiteStatus @default(PENDING)
  lastSyncedAt DateTime?  @map("last_synced_at")
  planId       String     @default("free") @map("plan_id") @db.VarChar(32)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  owner         User?             @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  credentials   SiteCredential[]
  connectCodes  SiteConnectCode[]
  products      Product[]
  conversations  Conversation[]
  usageEvents    UsageEvent[]
  aiUsageRecords AiUsageRecord[]
  assistant      AssistantSettings?

  @@index([domain])
  @@index([ownerUserId])
  @@map("sites")
}

/// Per-site storefront assistant appearance and voice settings.
model AssistantSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  siteId             String   @unique @map("site_id") @db.Uuid
  name               String   @default("Shoppio Assistant") @db.VarChar(80)
  welcomeMessage     String   @map("welcome_message") @db.Text
  language           String   @default("en") @db.VarChar(16)
  tone               String   @default("friendly") @db.VarChar(32)
  primaryColor       String   @default("#0F766E") @map("primary_color") @db.VarChar(16)
  suggestedQuestions Json     @default("[]") @map("suggested_questions")
  /// Distance of the chat launcher from the right edge (px).
  offsetRight        Int      @default(20) @map("offset_right")
  /// Distance of the chat launcher from the bottom edge (px).
  offsetBottom       Int      @default(20) @map("offset_bottom")
  /// Search/AI vertical: auto | generic | doors
  industry           String   @default("auto") @db.VarChar(32)
  /// Extra merchant instructions appended to the system prompt.
  customInstructions String   @default("") @map("custom_instructions") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("assistant_settings")
}

model SiteConnectCode {
  id        String    @id @default(uuid()) @db.Uuid
  siteId    String    @map("site_id") @db.Uuid
  code      String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_connect_codes")
}

model SiteCredential {
  id         String           @id @default(uuid()) @db.Uuid
  siteId     String           @map("site_id") @db.Uuid
  keyId      String           @unique @map("key_id")
  secretHash String           @map("secret_hash")
  label      String           @default("default")
  status     CredentialStatus @default(ACTIVE)
  lastUsedAt DateTime?        @map("last_used_at")
  revokedAt  DateTime?        @map("revoked_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("site_credentials")
}

model Product {
  id                String   @id @default(uuid()) @db.Uuid
  siteId            String   @map("site_id") @db.Uuid
  externalProductId String   @map("external_product_id")
  name              String
  description       String?  @db.Text
  price             Decimal? @db.Decimal(12, 2)
  currency          String?  @db.VarChar(3)
  url               String?
  imageUrl          String?  @map("image_url")
  stockStatus       String?  @map("stock_status") @db.VarChar(32)
  category          String?
  sku               String?  @db.VarChar(128)
  /// WooCommerce product tags (string array).
  tags              Json     @default("[]")
  /// Flat attribute map, e.g. { "Color": "White", "Size": ["M","L"] }.
  attributes        Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, externalProductId])
  @@index([siteId])
  @@index([siteId, name])
  @@index([siteId, sku])
  @@map("products")
}

model Conversation {
  id                String             @id @default(uuid()) @db.Uuid
  siteId            String             @map("site_id") @db.Uuid
  externalSessionId String?            @map("external_session_id")
  status            ConversationStatus @default(OPEN)
  metadata          Json?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([siteId])
  @@index([siteId, externalSessionId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String      @db.Text
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model UsageEvent {
  id        String   @id @default(uuid()) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  type      String
  quantity  Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([siteId, type, createdAt])
  @@map("usage_events")
}

/// Configurable plan catalog. Business logic reads these rows;
/// `plans.catalog.ts` seeds them and can later be replaced by admin edits.
model Plan {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String   @unique @db.VarChar(32)
  description          String   @db.Text
  priceMonthly         Int      @map("price_monthly")
  priceAnnual          Int?     @map("price_annual")
  maxSites             Int      @map("max_sites")
  maxProducts          Int      @map("max_products")
  maxAiMessages        Int      @map("max_ai_messages")
  /// Null means conversation history is not time-limited.
  historyRetentionDays Int?     @map("history_retention_days")
  features             Json
  highlights           Json
  highlighted          Boolean  @default(false)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

/// One current subscription per account. Provider ids stay empty for Free.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @map("user_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  /// Abstract provider key: none, paddle, stripe, or a future market-specific id.
  provider               String             @default("none") @db.VarChar(32)
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  status                 SubscriptionStatus @default(ACTIVE)
  interval               BillingInterval    @default(MONTHLY)
  currentPeriodStart     DateTime           @map("current_period_start")
  currentPeriodEnd       DateTime           @map("current_period_end")
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

/// Monthly AI usage bucket. A new row starts each billing month so usage resets.
model UsagePeriod {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  aiMessages    Int      @default(0) @map("ai_messages")
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  totalTokens   Int      @default(0) @map("total_tokens")
  estimatedCost Decimal  @default(0) @map("estimated_cost") @db.Decimal(12, 6)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiUsageRecords AiUsageRecord[]

  @@unique([userId, periodStart])
  @@index([userId, periodEnd])
  @@map("usage_periods")
}

/// Per-request token usage for later cost accounting. Not shown to customers.
model AiUsageRecord {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  siteId        String?  @map("site_id") @db.Uuid
  usagePeriodId String?  @map("usage_period_id") @db.Uuid
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  totalTokens   Int      @default(0) @map("total_tokens")
  model         String?
  provider      String?  @db.VarChar(32)
  estimatedCost Decimal  @default(0) @map("estimated_cost") @db.Decimal(12, 6)
  createdAt     DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  site        Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  usagePeriod UsagePeriod? @relation(fields: [usagePeriodId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([siteId])
  @@map("ai_usage_records")
}
