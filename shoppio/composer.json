{
  "name": "shoppio/shoppio",
  "description": "Shoppio WordPress plugin — AI assistant bridge for WordPress/WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.11",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Shoppio\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shoppio\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/smoke.php",
    "test:phpunit": "phpunit",
    "phpstan": "phpstan analyse",
    "phpcs": "phpcs"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
