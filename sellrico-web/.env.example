# App
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Shoppio backend API (versioned base) — must match shoppio-backend PORT
NEXT_PUBLIC_API_URL=http://localhost:9001/api/v1

# Opt-in mocks for unfinished domains (billing / assistant / usage summary).
# Overview, sites, products, and auth always use the real API.
NEXT_PUBLIC_USE_MOCK_API=true
